rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helpers: quiz document model
    function isQuizDocValid(data) {
      return data.title is string
        && data.category is string
        && data.creatorId is string
        && data.shareCode is string
        && data.sharedWith is list
        && data.sharedWith.size() >= 1
        && data.sharedWith.all(x => x is string)
        && data.questions is list
        && data.questions.size() >= 1
        && data.questions.size() <= 50
        && data.questions.all(q =>
          q is map
          && q.text is string
          && q.options is list
          && q.options.size() >= 2
          && q.options.size() <= 6
          && q.options.all(o => o is string)
          && q.answerIndex is int
          && q.answerIndex >= 0
          && q.answerIndex < q.options.size()
        );
    }

    function isCreator() {
      return request.auth.uid == resource.data.creatorId;
    }

    function isSharedWith() {
      return resource.data.sharedWith is list
        && request.auth.uid in resource.data.sharedWith;
    }

    function isCreatorOrOwner() {
      return isCreator() || isSharedWith();
    }

    function isJoiningSharedWith() {
      // User may only add themselves to sharedWith by creating a valid quiz update.
      return isAuthenticated()
        && request.resource.data.sharedWith is list
        && request.auth.uid in request.resource.data.sharedWith
        && (
          // if sharedWith didn't exist, it must contain only themselves
          !('sharedWith' in resource.data)
            ? request.resource.data.sharedWith.size() == 1
            : request.resource.data.sharedWith.size() == resource.data.sharedWith.size() + (request.auth.uid in resource.data.sharedWith ? 0 : 1)
        );
    }

    // Quizzes
    match /quizzes/{quizId} {
      allow read: if isAuthenticated() && (isCreator() || isSharedWith());

      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.creatorId
        && request.auth.uid in request.resource.data.sharedWith
        && isQuizDocValid(request.resource.data);

      allow update: if isAuthenticated()
        && (isCreatorOrOwner() || isJoiningSharedWith())
        && isQuizDocValid(request.resource.data);

      allow delete: if isAuthenticated() && isCreator();
    }

    // Share codes
    function isShareCodeDocValid(data) {
      return data.quizId is string
        && data.creatorId is string
        && data.createdAt is timestamp;
    }

    // Only the quiz creator can create/delete their share codes.
    function isShareCodeOwnerOnCreate() {
      return isAuthenticated()
        && request.resource.data.creatorId == request.auth.uid
        && isShareCodeDocValid(request.resource.data)
        && exists(/databases/$(database)/documents/quizzes/$(request.resource.data.quizId))
        && get(/databases/$(database)/documents/quizzes/$(request.resource.data.quizId)).data.creatorId == request.auth.uid;
    }

    function isShareCodeOwnerOnDelete() {
      return isAuthenticated()
        && resource.data.creatorId == request.auth.uid
        && exists(/databases/$(database)/documents/quizzes/$(resource.data.quizId))
        && get(/databases/$(database)/documents/quizzes/$(resource.data.quizId)).data.creatorId == request.auth.uid;
    }

    // READ: only if the caller is the quiz creator or included in the quiz sharedWith.
    // This prevents random users from enumerating share codes.
    match /shareCodes/{code} {
      allow read: if isAuthenticated()
        && exists(/databases/$(database)/documents/quizzes/$(resource.data.quizId))
        && (
          resource.data.creatorId == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/quizzes/$(resource.data.quizId)).data.sharedWith
        );

      allow create: if isShareCodeOwnerOnCreate();

      allow delete: if isShareCodeOwnerOnDelete();
    }
  }
}

