rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the current user is the creator
    function isCreator() {
      return request.auth.uid == resource.data.creatorId;
    }

    // Helper function to check if user is creator (with fallback for missing creatorId)
    function isCreatorOrOwner() {
      return (request.auth.uid == resource.data.creatorId) ||
             (!('creatorId' in resource.data) && request.auth.uid in resource.data.sharedWith);
    }

    // Helper function to check if the current user is in the sharedWith array
    function isSharedWith() {
      return request.auth.uid in resource.data.sharedWith;
    }

    function hasSharedWith() {
      return 'sharedWith' in resource.data;
    }

    // Helper function for importing quizzes by adding the current user to sharedWith
    function isJoiningSharedWith() {
      return request.auth != null
        && request.auth.uid in request.resource.data.sharedWith
        && request.resource.data.sharedWith.hasAll(hasSharedWith() ? resource.data.sharedWith : [])
        && (
             !hasSharedWith()
               ? request.resource.data.sharedWith.size() == 1
               : request.resource.data.sharedWith.size() == resource.data.sharedWith.size() + (request.auth.uid in resource.data.sharedWith ? 0 : 1)
           );
    }

    match /quizzes/{quizId} {
      // Allow read if the user is authenticated AND (is creator OR is in sharedWith)
      allow read: if isAuthenticated() && (isCreator() || isSharedWith());

      // Allow create if authenticated. The creator must put themselves in sharedWith.
      allow create: if isAuthenticated() 
        && request.auth.uid == request.resource.data.creatorId
        && request.auth.uid in request.resource.data.sharedWith;

      // Allow update by creator OR by a user joining sharedWith via import
      allow update: if isAuthenticated() && (isCreatorOrOwner() || isJoiningSharedWith());

      // Allow delete only if creator (with fallback for old docs missing creatorId)
      allow delete: if isAuthenticated() && isCreatorOrOwner();
    }

    match /shareCodes/{code} {
      // Allow any authenticated user to read share codes for importing quizzes
      allow read: if isAuthenticated();
      // Only authenticated users can create share code entries
      allow create: if isAuthenticated();
      // Allow delete by authenticated users (share codes are ephemeral and linked to quizzes)
      allow delete: if isAuthenticated();
    }
  }
}

